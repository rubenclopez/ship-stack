NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
NEXT_PUBLIC_BASE_URL=

# Runtime secrets — inject via docker run -e or your orchestrator's secret store
SUPABASE_SERVICE_ROLE_KEY=
EMAIL_API_KEY=
EMAIL_FROM=
